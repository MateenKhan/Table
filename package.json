{
  "name": "@jugaaadi/table",
  "version": "0.1.0",
  "description": "A world-class, spreadsheet-style data table for React built on TanStack Table v8 — editable cells, formulas, rich column types, borders/formatting, find & replace, shareable views, and a build-your-own blank sheet.",
  "license": "MIT",
  "author": "Mateen Khan",
  "repository": {
    "type": "git",
    "url": "https://github.com/MateenKhan/Table"
  },
  "homepage": "https://github.com/MateenKhan/Table#readme",
  "keywords": [
    "react",
    "table",
    "spreadsheet",
    "tanstack",
    "data-grid",
    "datagrid",
    "editable",
    "formulas"
  ],
  "type": "module",
  "main": "./dist/table.js",
  "module": "./dist/table.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/table.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "serve": "vite preview",
    "start": "vite",
    "prepack": "npm run build:lib",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-table": "^8.21.3",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.469.0",
    "lz-string": "^1.5.0",
    "react-colorful": "^5.8.0",
    "react-day-picker": "^9.14.0",
    "react-dropzone": "^14.4.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@rollup/plugin-replace": "^5.0.7",
    "@types/lz-string": "^1.3.34",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "5.4.5",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.3"
  }
}
